# --- APP CONFIG ---
ENVIRONMENT=local # local | production
DEBUG=True
SECRET_KEY=your-secret-key-here

# --- DATABASE (Supabase in Prod) ---
DATABASE_URL=sqlite:///./test.db # Local fallback
# POSTGRES_URL=postgresql://user:pass@host:5432/db

# --- OBJECT STORAGE (Cloudflare R2 in Prod) ---
STORAGE_MODE=local # local | s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password
S3_BUCKET_NAME=cdp-datalake-assets
S3_REGION=auto

# --- ML OPS (DagsHub in Prod) ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_TRACKING_USERNAME=your-dagshub-username
MLFLOW_TRACKING_PASSWORD=your-dagshub-token
# Cần thiết để MLflow client upload artifacts lên R2/MinIO (boto3 dùng biến này)
# Prod R2:   https://<account-id>.r2.cloudflarestorage.com
# Local Dev: http://localhost:9000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

# --- AI LAYER ---
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# --- SPRINT 1 PRODUCTION READINESS ---
MAX_UPLOAD_SIZE_MB=50
ENV=development

# --- SPRINT 2 PRODUCTION READINESS ---
RATE_LIMIT_UPLOAD=10
RATE_LIMIT_TRAIN=5
RATE_LIMIT_PREDICT=100
MAX_TRAINING_MINUTES=30
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- SPRINT 3 PRODUCTION READINESS ---
# Multi-instance deployment: Set ENABLE_DRIFT_SCHEDULER=true on ONLY ONE instance to avoid double-triggering.
ENABLE_DRIFT_SCHEDULER=true
INFERENCE_RETENTION_DAYS=30
